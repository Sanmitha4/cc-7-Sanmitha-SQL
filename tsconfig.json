{
  "compilerOptions": {
    /* Projects & File Layout */
    "rootDir": "./src",                          /* Where your .ts files live */
    "outDir": "./dist",                         /* Where your compiled .js files will go */
    "removeComments": false,                    /* Keep comments for better readability in dist */

    /* Language and Environment */
    "target": "ESNext",                         /* Use latest JavaScript features */
    "module": "NodeNext",                       /* Required for modern Node.js ESM support */
    "moduleResolution": "NodeNext",             /* Helps resolve .js extensions in imports */
    "lib": ["ESNext"],    
    "types": ["node"],                      /* Include standard JS library types */

    /* Decorator Support (CRITICAL) */
    "experimentalDecorators": true,             /* Enables the @Table syntax */
    "emitDecoratorMetadata": true,              /* Enables reflection for the ORM */

    /* Output Settings */
    "sourceMap": true,                          /* For debugging in WSL/VS Code */
    "declaration": true,                        /* Generates .d.ts files for type safety */
    "declarationMap": true,                     /* Maps .d.ts back to source code */

    /* Strict Type-Checking */
    "strict": true,                             /* Enables all strict type-checking options */
    "noImplicitAny": true,                      /* Error on expressions with implied 'any' type */
    "strictNullChecks": true,                   /* Ensures you handle null/undefined */
    "noUncheckedIndexedAccess": true,           /* Checks access to arrays/objects */

    /* Interop Constraints */
    "esModuleInterop": true,                    /* Support for CommonJS/ESM compatibility */
    "forceConsistentCasingInFileNames": true,   /* Fixes issues between Windows and Linux/WSL */
    "skipLibCheck": true,                       /* Speeds up compilation */
    "verbatimModuleSyntax": true                /* Ensures imports aren't changed by compiler */
  },
  "include": ["src/**/*"],                      /* Compile everything in the src folder */
  "exclude": ["node_modules", "**/*.spec.ts"]   /* Ignore dependencies and test files */
}